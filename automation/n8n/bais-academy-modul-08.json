    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(item=>item.json);\nconst prepared=$('Prepare File Scenario').item.json;\nconst binary=$('Convert to CSV File').first().binary?.data??{};\nconst riskCount=rows.filter(r=>String(r._formulaSanitized)===\"true\"||r._formulaSanitized===true).length;\nreturn [{json:{\n ok:true,module:\"08\",case:prepared.scenario,format:\"csv\",\n binary:{\n   property:\"data\",\n   fileName:binary.fileName??\"bais-module08-orders.csv\",\n   mimeType:binary.mimeType??\"text/csv\",\n   fileExtension:binary.fileExtension??\"csv\",\n   fileSize:binary.fileSize??null\n },\n extracted:{rowCount:rows.length,rows},\n security:{formulaSanitizedRows:riskCount,rule:\"Cells beginning with = + - @ are prefixed with apostrophe before spreadsheet export.\"},\n lesson:prepared.scenario===\"unsafe\"\n  ?\"Potential spreadsheet-formula cells were neutralized before file creation.\"\n  :\"JSON items became real CSV binary data and were parsed back into JSON rows.\"\n}}];"
      },
