    {
      "parameters": {
        "jsCode": "const item=$input.first().json;\nconst prepared=$('Prepare File Scenario').item.json;\nconst binary=$('Convert to JSON File').first().binary?.data??{};\nconst document=item.document;\nconst records=Array.isArray(document)?document:[document];\nreturn [{json:{\n ok:true,module:\"08\",case:prepared.scenario,format:\"json\",\n binary:{\n  property:\"data\",\n  fileName:binary.fileName??\"bais-module08-tickets.json\",\n  mimeType:binary.mimeType??\"application/json\",\n  fileExtension:binary.fileExtension??\"json\",\n  fileSize:binary.fileSize??null\n },\n extracted:{rowCount:records.length,records},\n lesson:\"Multiple JSON items became one real binary .json file and were parsed back after file conversion.\"\n}}];"
      },
