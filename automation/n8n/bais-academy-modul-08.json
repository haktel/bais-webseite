    {
      "parameters": {
        "jsCode": "const scenario=String($input.first().json.body?.scenario??\"\").trim();\nconst samples={\n csv:{format:\"csv\",records:[\n  {orderId:\"O-1001\",name:\"Mina Yilmaz\",email:\"mina@example.com\",amount:129.9,note:\"standard\"},\n  {orderId:\"O-1002\",name:\"Jonas Weber\",email:\"jonas@example.com\",amount:89.5,note:\"priority\"},\n  {orderId:\"O-1003\",name:\"Elif Kaya\",email:\"elif@example.com\",amount:240,note:\"standard\"}\n ]},\n unicode:{format:\"csv\",records:[\n  {orderId:\"U-1\",name:\"Büşra Şahin\",email:\"busra@example.com\",amount:199.95,note:\"İstanbul\"},\n  {orderId:\"U-2\",name:\"Jörg Müller\",email:\"joerg@example.com\",amount:75.4,note:\"München\"},\n  {orderId:\"U-3\",name:\"Çağla Öztürk\",email:\"cagla@example.com\",amount:310,note:\"Düsseldorf\"}\n ]},\n json:{format:\"json\",records:[\n  {ticketId:\"T-101\",title:\"VPN Problem\",severity:\"high\",open:true},\n  {ticketId:\"T-102\",title:\"Password Reset\",severity:\"low\",open:false}\n ]},\n unsafe:{format:\"csv\",records:[\n  {orderId:\"S-1\",name:\"=2+2\",email:\"safe@example.com\",amount:50,note:\"+SUM(1,1)\"},\n  {orderId:\"S-2\",name:\"@malicious\",email:\"safe2@example.com\",amount:60,note:\"-10+20\"}\n ]},\n invalid:{format:\"invalid\",records:[]}\n};\nconst selected=samples[scenario];\nif(!selected)return [{json:{valid:false,scenario,error:\"unknown_scenario\"}}];\nreturn [{json:{valid:scenario!==\"invalid\",scenario,...selected,error:scenario===\"invalid\"?\"records must not be empty\":\"\"}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        0
      ],
