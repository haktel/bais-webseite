      "id": "m08-switch",
      "name": "CSV or JSON?"
    },
    {
      "parameters": {
        "jsCode": "const prepared=$input.first().json;\nconst risky=/^[=+\\-@]/;\nlet riskCount=0;\nconst rows=(prepared.records??[]).map((record,index)=>{\n const clean={};\n let rowRisk=false;\n for(const [key,value] of Object.entries(record)){\n  if(typeof value===\"string\"&&risky.test(value)){\n   clean[key]=\"'\"+value;\n   riskCount++;\n   rowRisk=true;\n  }else clean[key]=value;\n }\n return {...clean,_row:index+1,_formulaSanitized:rowRisk};\n});\nreturn rows.map(row=>({json:row}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        -200
      ],
