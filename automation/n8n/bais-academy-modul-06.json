        "jsCode": "const scenario=String($input.first().json.body?.scenario??\"\").trim();\nconst map={\n success:{statusCode:200,expectedAction:\"continue\",retryable:false},\n client:{statusCode:400,expectedAction:\"reject\",retryable:false},\n rate:{statusCode:429,expectedAction:\"retry_backoff\",retryable:true},\n server:{statusCode:500,expectedAction:\"retry_backoff\",retryable:true}\n};\nif(!map[scenario])return [{json:{valid:false,scenario,error:\"unknown_scenario\"}}];\nreturn [{json:{valid:true,scenario,...map[scenario]}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
