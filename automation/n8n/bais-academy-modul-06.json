      "name": "Call Unstable Upstream"
    },
    {
      "parameters": {
        "jsCode": "const response=$input.first().json;\nconst prepared=$('Prepare Scenario').item.json;\nconst status=Number(response.statusCode??response.status??response.body?.status??0);\nlet failureClass=\"success\",action=\"continue\",retryable=false,reason=\"2xx response\";\nif(status===429){failureClass=\"rate_limit\";action=\"retry_backoff\";retryable=true;reason=\"Rate limit: Retry-After/Backoff beachten\";}\nelse if(status>=500){failureClass=\"server_error\";action=\"retry_backoff\";retryable=true;reason=\"Temporärer Upstream-Fehler kann retrybar sein\";}\nelse if(status>=400){failureClass=\"client_error\";action=\"reject\";retryable=false;reason=\"Request/Policy korrigieren statt blind retryen\";}\nconst matches=action===prepared.expectedAction&&retryable===prepared.retryable;\nreturn [{json:{\n  ok:matches,module:\"06\",case:prepared.scenario,\n  upstream:{status,body:response.body??null},\n  classification:{failureClass,retryable,action,reason},\n  expected:{action:prepared.expectedAction,retryable:prepared.retryable},\n  policy:{\n    retryableStatuses:[429,500,502,503,504],\n    nonGenericRetry:[400,401,403,404,422],\n    maxRetries:3,\n    backoffExampleSeconds:[1,2,4],\n    note:\"Retry nur, wenn Operation sicher wiederholbar/idempotent ist.\"\n  }\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
