      "parameters": {
        "jsCode": "const scenario=String($input.first().json.body?.scenario??\"\").trim();\nconst allowed=[\"api-key\",\"bearer\",\"forbidden\",\"expired\"];\nif(!allowed.includes(scenario)){\n  return [{json:{valid:false,scenario,error:\"unknown_scenario\"}}];\n}\nconst map={\n  \"api-key\":{\n    authType:\"API Key\",\n    apiKey:\"bais-demo-key-read\",\n    authorization:\"\",\n    expectedStatus:200,\n    expectedMeaning:\"Credential gültig und Scope customer:read vorhanden.\"\n  },\n  \"bearer\":{\n    authType:\"Bearer Token\",\n    apiKey:\"\",\n    authorization:\"Bearer bais-demo-token-read\",\n    expectedStatus:200,\n    expectedMeaning:\"Token gültig und Scope customer:read vorhanden.\"\n  },\n  \"forbidden\":{\n    authType:\"Bearer Token\",\n    apiKey:\"\",\n    authorization:\"Bearer bais-demo-token-no-scope\",\n    expectedStatus:403,\n    expectedMeaning:\"Identität bekannt, aber Scope customer:read fehlt.\"\n  },\n  \"expired\":{\n    authType:\"Bearer Token\",\n    apiKey:\"\",\n    authorization:\"Bearer bais-demo-token-expired\",\n    expectedStatus:401,\n    expectedMeaning:\"Token ist abgelaufen; Re-Authentication/Refresh wäre erforderlich.\"\n  }\n};\nreturn [{json:{valid:true,scenario,...map[scenario]}}];"
      },
