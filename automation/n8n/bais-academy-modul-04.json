    {
      "parameters": {
        "jsCode": "const response=$input.first().json;\nconst prepared=$('Prepare Auth Scenario').item.json;\nconst status=Number(response.statusCode??response.status??response.body?.status??0);\nconst body=response.body??response;\nconst passed=status===Number(prepared.expectedStatus);\nreturn [{json:{\n  ok:passed,\n  module:\"04\",\n  case:prepared.scenario,\n  authType:prepared.authType,\n  expectedStatus:prepared.expectedStatus,\n  observedStatus:status,\n  expectedMeaning:prepared.expectedMeaning,\n  authorizationModel:{\n    credentialPresented:prepared.scenario===\"api-key\"?\"X-API-Key\":\"Authorization: Bearer ***\",\n    requiredScope:\"customer:read\",\n    note:\"Demo credentials only — never use these values as real secrets.\"\n  },\n  protectedResource:body,\n  lesson:status===200\n    ?\"Authentifizierung + Autorisierung erfolgreich.\"\n    :status===401\n      ?\"401: Credential fehlt/ungültig/abgelaufen. Identität ist nicht erfolgreich authentisiert.\"\n      :status===403\n        ?\"403: Identität ist bekannt, aber Berechtigung/Scope fehlt.\"\n        :\"Unerwarteter Status — Request/Response prüfen.\"\n}}];"
      },
