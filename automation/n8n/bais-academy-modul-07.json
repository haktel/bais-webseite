        "jsCode": "const body=$input.first().json.body??{};\nconst scenario=String(body.scenario??\"\").trim();\nconst labKey=String(body.labKey??\"\").trim().replace(/[^a-zA-Z0-9_-]/g,\"\").slice(0,48);\nif(!labKey||![\"create\",\"update\",\"event-first\",\"event-repeat\"].includes(scenario)){\n return [{json:{valid:false,scenario,labKey,error:\"invalid scenario or labKey\"}}];\n}\nconst customerId=\"C-\"+labKey;\nconst isCustomer=[\"create\",\"update\"].includes(scenario);\nconst isUpdate=scenario===\"update\";\nreturn [{json:{\n valid:true,\n scenario,\n kind:isCustomer?\"customer\":\"event\",\n labKey,\n customerId,\n customer:{\n   customerId,\n   name:isUpdate?\"Mina Yilmaz · Updated\":\"Mina Yilmaz\",\n   status:isUpdate?\"qualified\":\"lead\",\n   score:isUpdate?85:10,\n   source:\"bais-academy\"\n },\n event:{\n   eventId:\"EV-\"+labKey,\n   eventType:\"payment_received\",\n   customerId,\n   processed:true,\n   source:\"bais-academy\"\n }\n}}];"
