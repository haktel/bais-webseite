      "parameters": {
        "jsCode": "const row=$input.first().json;\nconst prepared=$('Prepare Persistence Scenario').item.json;\nreturn [{json:{\n ok:true,module:\"07\",case:prepared.scenario,\n persistence:\"n8n_data_table\",\n operation:\"upsert\",\n table:\"BAIS Academy Modul 07 Customers\",\n matchKey:\"customerId\",\n row:{\n   id:row.id??null,\n   customerId:row.customerId,\n   name:row.name,\n   status:row.status,\n   score:row.score,\n   source:row.source,\n   createdAt:row.createdAt??null,\n   updatedAt:row.updatedAt??null\n },\n lesson:prepared.scenario===\"update\"\n  ?\"Same customerId matched: existing logical customer was updated instead of blindly inserting a duplicate.\"\n  :\"Customer state is persisted in n8n and can be read again in another execution.\"\n}}];"
