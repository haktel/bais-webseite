        "jsCode": "const body=$input.first().json.body??{};\nconst orders=Array.isArray(body.orders)?body.orders.slice(0,20):[];\nconst normalized=orders.map((order,index)=>({\n  orderId:String(order?.orderId??\"\").trim(),\n  total:Number(order?.total),\n  region:String(order?.region??\"\").trim().toUpperCase(),\n  priority:String(order?.priority??\"normal\").trim().toLowerCase(),\n  index\n}));\nconst invalid=normalized.filter(o=>!o.orderId||!Number.isFinite(o.total)||o.total<0||!o.region);\nreturn [{json:{\n  batchValid:normalized.length>0&&invalid.length===0,\n  orderCount:normalized.length,\n  invalidCount:invalid.length,\n  orders:normalized,\n  error:normalized.length===0?\"orders array is required\":invalid.length?\"one or more orders are invalid\":\"\"\n}}];"
