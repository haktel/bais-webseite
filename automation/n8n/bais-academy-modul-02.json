    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst records = Array.isArray(body.records) ? body.records.slice(0, 20) : [];\nif (!records.length) {\n  return [{ json: { _invalid: true, error: \"records array with at least one item is required\" } }];\n}\nreturn records.map((record, index) => ({\n  json: {\n    _invalid: false,\n    index,\n    firstName: String(record.firstName ?? \"\"),\n    lastName: String(record.lastName ?? \"\"),\n    email: String(record.email ?? \"\"),\n    budget: record.budget,\n    tags: Array.isArray(record.tags) ? record.tags : [],\n    source: String(record.source ?? body.source ?? \"unknown\")\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ],
      "id": "b677c46a-688f-4290-b076-55a2d13bf1f0",
