    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tags = Array.isArray($json.tags)\n  ? [...new Set($json.tags.map(tag => String(tag).trim()).filter(Boolean))]\n  : [];\nconst fullName = [String($json.firstName).trim(), String($json.lastName).trim()].filter(Boolean).join(\" \");\nconst email = String($json.email).trim().toLowerCase();\nconst budget = Number($json.budget);\nreturn {\n  json: {\n    index: $json.index,\n    fullName,\n    email,\n    budget: Number.isFinite(budget) ? budget : null,\n    tags,\n    source: String($json.source).trim().toLowerCase(),\n    valid: Boolean(fullName && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) && Number.isFinite(budget))\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        -100
      ],
      "id": "c4fd082b-fd30-4af1-8750-8b9ac0e989d5",
      "name": "Normalize Each Item"
    },
    {
      "parameters": {
        "jsCode": "const records = $input.all().map(item => item.json);\nreturn [{\n  json: {\n    ok: true,\n    normalized: true,\n    itemCount: records.length,\n    validCount: records.filter(record => record.valid).length,\n    records\n  }\n}];"
      },
