      "parameters": {
        "jsCode": "const body=$input.first().json.body??{};\nconst operation=String(body.operation??\"\").trim().toUpperCase();\nconst customerId=String(body.customerId??\"\").trim();\nconst name=String(body.name??\"\").trim();\nconst email=String(body.email??\"\").trim().toLowerCase();\nconst validOperation=[\"GET\",\"POST\"].includes(operation);\nconst validBase=Boolean(customerId);\nconst validPost=operation!==\"POST\"||Boolean(name&&/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email));\nreturn [{json:{\n  valid:validOperation&&validBase&&validPost,\n  operation,\n  customerId,\n  name,\n  email,\n  validation:{\n    validOperation,\n    customerId:Boolean(customerId),\n    postBody:validPost\n  }\n}}];"
      },
