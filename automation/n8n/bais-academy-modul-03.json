        "jsCode": "const upstream=$input.first().json;\nconst prepared=$('Validate & Prepare').item.json;\nreturn [{json:{\n  ok:true,\n  module:\"03\",\n  case:\"get\",\n  request:{\n    method:\"GET\",\n    url:\"https://postman-echo.com/get\",\n    query:{customerId:prepared.customerId,source:\"bais-academy\",module:\"03\"},\n    headers:{\"X-BAIS-Lab\":\"module-03\",\"Accept\":\"application/json\"}\n  },\n  response:{\n    echoedArgs:upstream.args??{},\n    echoedHeaders:{\n      xBaisLab:upstream.headers?.[\"x-bais-lab\"]??upstream.headers?.[\"X-Bais-Lab\"]??null\n    },\n    url:upstream.url??null\n  }\n}}];"
